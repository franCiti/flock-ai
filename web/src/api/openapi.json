{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "tags" : [ {
    "name" : "config",
    "description" : "Settings for the web app"
  }, {
    "name" : "ingestion",
    "description" : "Knowledge updates"
  }, {
    "name" : "audit",
    "description" : "Record of the processed questions"
  }, {
    "name" : "chat",
    "description" : "Questions to a virtual persona and their streamed replies"
  }, {
    "name" : "auth",
    "description" : "Session of the web app (cookie)"
  }, {
    "name" : "personas",
    "description" : "Virtual personas"
  } ],
  "paths" : {
    "/api/ingestion/runs" : {
      "get" : {
        "tags" : [ "ingestion" ],
        "summary" : "History of the knowledge updates, newest first",
        "operationId" : "history",
        "parameters" : [ {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/IngestionRun"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "ingestion" ],
        "summary" : "Update the knowledge base now",
        "operationId" : "request",
        "responses" : {
          "202" : {
            "description" : "Requested; its progress shows in the history",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RequestedRun"
                }
              }
            }
          },
          "503" : {
            "description" : "Kafka is not available",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversationId}/messages" : {
      "post" : {
        "tags" : [ "chat" ],
        "summary" : "Ask a question: its replies arrive through the stream of the conversation",
        "operationId" : "send",
        "parameters" : [ {
          "name" : "conversationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 1
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Question"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Sent to the agent",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SentQuestion"
                }
              }
            }
          },
          "503" : {
            "description" : "Kafka is not available",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Sign in: opens a session (cookie)",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Signed in"
          },
          "401" : {
            "description" : "Wrong username or password"
          }
        }
      }
    },
    "/api/personas" : {
      "get" : {
        "tags" : [ "personas" ],
        "summary" : "Available personas, by display name",
        "operationId" : "list",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PersonaView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversationId}/stream" : {
      "get" : {
        "tags" : [ "chat" ],
        "summary" : "Replies of the conversation (Server-Sent Events)",
        "description" : "Each event is an AgentReply of the contract (accepted, token, final, error) with id <requestId>:<seq>. Reconnecting with Last-Event-ID replays what was missed of the request in progress.",
        "operationId" : "stream",
        "parameters" : [ {
          "name" : "conversationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 1
          }
        }, {
          "name" : "Last-Event-ID",
          "in" : "header",
          "description" : "Id of the last event received",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The stream of events",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/config" : {
      "get" : {
        "tags" : [ "config" ],
        "summary" : "Settings for the web app",
        "operationId" : "config",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "The signed-in user",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "There is a session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401" : {
            "description" : "No session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit" : {
      "get" : {
        "tags" : [ "audit" ],
        "summary" : "Entries of the audit log, newest first; the filters apply together",
        "operationId" : "find",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "description" : "Page number, from 0",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "name" : "personaId",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "First moment included (ISO 8601)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "to",
          "in" : "query",
          "description" : "First moment excluded (ISO 8601)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "outcome",
          "in" : "query",
          "description" : "Entries with any of these outcomes",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "answered", "partially_answered", "no_information", "out_of_scope", "small_talk", "about_assistant", "error" ]
            }
          }
        }, {
          "name" : "flag",
          "in" : "query",
          "description" : "Entries with any of these flags",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "injection_suspected", "rate_limited", "question_too_long", "invalid_request" ]
            }
          }
        }, {
          "name" : "referred",
          "in" : "query",
          "description" : "Whether the answer suggested another persona",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuditPage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "RequestedRun" : {
        "type" : "object",
        "properties" : {
          "jobId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "Question" : {
        "type" : "object",
        "properties" : {
          "personaId" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "question" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "personaId", "question" ]
      },
      "SentQuestion" : {
        "type" : "object",
        "properties" : {
          "requestId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "password", "username" ]
      },
      "PersonaView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          }
        }
      },
      "IngestionRun" : {
        "type" : "object",
        "properties" : {
          "jobId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "trigger" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "requestedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "finishedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "totals" : {
            "$ref" : "#/components/schemas/Totals"
          },
          "personas" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PersonaSummary"
            }
          },
          "removedPersonas" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "PersonaSummary" : {
        "type" : "object",
        "properties" : {
          "personaId" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "added" : {
            "type" : "integer",
            "format" : "int32"
          },
          "modified" : {
            "type" : "integer",
            "format" : "int32"
          },
          "deleted" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unchanged" : {
            "type" : "integer",
            "format" : "int32"
          },
          "secretsMasked" : {
            "type" : "integer",
            "format" : "int32"
          },
          "skipped" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SkippedFile"
            }
          },
          "sourceErrors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SourceError"
            }
          }
        }
      },
      "SkippedFile" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "SourceError" : {
        "type" : "object",
        "properties" : {
          "sourceId" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "Totals" : {
        "type" : "object",
        "properties" : {
          "personas" : {
            "type" : "integer",
            "format" : "int32"
          },
          "added" : {
            "type" : "integer",
            "format" : "int32"
          },
          "modified" : {
            "type" : "integer",
            "format" : "int32"
          },
          "deleted" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unchanged" : {
            "type" : "integer",
            "format" : "int32"
          },
          "skipped" : {
            "type" : "integer",
            "format" : "int32"
          },
          "secretsMasked" : {
            "type" : "integer",
            "format" : "int32"
          },
          "sourceErrors" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "ClientConfig" : {
        "type" : "object",
        "properties" : {
          "maxQuestionChars" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "CurrentUser" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          }
        }
      },
      "AuditPage" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AuditRecord"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalItems" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "AuditRecord" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "requestId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "clientId" : {
            "type" : "string"
          },
          "conversationId" : {
            "type" : "string"
          },
          "personaId" : {
            "type" : "string"
          },
          "question" : {
            "type" : "string"
          },
          "answer" : {
            "type" : "string"
          },
          "outcome" : {
            "type" : "string",
            "enum" : [ "answered", "partially_answered", "no_information", "out_of_scope", "small_talk", "about_assistant", "error" ]
          },
          "errorCode" : {
            "type" : "string",
            "enum" : [ "INVALID_REQUEST", "UNSUPPORTED_VERSION", "PERSONA_NOT_FOUND", "QUESTION_TOO_LONG", "RATE_LIMITED", "TIMEOUT", "LLM_UNAVAILABLE", "INTERNAL_ERROR" ]
          },
          "citations" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Citation"
            }
          },
          "referralPersonaId" : {
            "type" : "string"
          },
          "flags" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "injection_suspected", "rate_limited", "question_too_long", "invalid_request" ]
            }
          },
          "llmModel" : {
            "type" : "string"
          },
          "promptVersion" : {
            "type" : "string"
          },
          "firstTokenMs" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalMs" : {
            "type" : "integer",
            "format" : "int32"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "Citation" : {
        "type" : "object",
        "properties" : {
          "documentId" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string",
            "format" : "uri"
          },
          "path" : {
            "type" : "string"
          },
          "section" : {
            "type" : "string"
          },
          "sourceType" : {
            "type" : "string",
            "enum" : [ "file", "email", "email_attachment", "jira", "confluence", "sharepoint" ]
          }
        }
      }
    }
  }
}
