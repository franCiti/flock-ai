{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "tags" : [ {
    "name" : "ingestion",
    "description" : "Knowledge updates"
  }, {
    "name" : "chat",
    "description" : "Questions to a virtual persona and their streamed replies"
  }, {
    "name" : "auth",
    "description" : "Session of the web app (cookie)"
  } ],
  "paths" : {
    "/api/ingestion/runs" : {
      "get" : {
        "tags" : [ "ingestion" ],
        "summary" : "History of the knowledge updates, newest first",
        "operationId" : "history",
        "parameters" : [ {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/IngestionRun"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "ingestion" ],
        "summary" : "Update the knowledge base now",
        "operationId" : "request",
        "responses" : {
          "202" : {
            "description" : "Requested; its progress shows in the history",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RequestedRun"
                }
              }
            }
          },
          "503" : {
            "description" : "Kafka is not available",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversationId}/messages" : {
      "post" : {
        "tags" : [ "chat" ],
        "summary" : "Ask a question: its replies arrive through the stream of the conversation",
        "operationId" : "send",
        "parameters" : [ {
          "name" : "conversationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 1
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Question"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Sent to the agent",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SentQuestion"
                }
              }
            }
          },
          "503" : {
            "description" : "Kafka is not available",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Sign in: opens a session (cookie)",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Signed in"
          },
          "401" : {
            "description" : "Wrong username or password"
          }
        }
      }
    },
    "/api/conversations/{conversationId}/stream" : {
      "get" : {
        "tags" : [ "chat" ],
        "summary" : "Replies of the conversation (Server-Sent Events)",
        "description" : "Each event is an AgentReply of the contract (accepted, token, final, error) with id <requestId>:<seq>. Reconnecting with Last-Event-ID replays what was missed of the request in progress.",
        "operationId" : "stream",
        "parameters" : [ {
          "name" : "conversationId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 1
          }
        }, {
          "name" : "Last-Event-ID",
          "in" : "header",
          "description" : "Id of the last event received",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The stream of events",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "The signed-in user",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "There is a session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401" : {
            "description" : "No session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "RequestedRun" : {
        "type" : "object",
        "properties" : {
          "jobId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "Question" : {
        "type" : "object",
        "properties" : {
          "personaId" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "question" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "personaId", "question" ]
      },
      "SentQuestion" : {
        "type" : "object",
        "properties" : {
          "requestId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "password", "username" ]
      },
      "IngestionRun" : {
        "type" : "object",
        "properties" : {
          "jobId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "trigger" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "requestedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "finishedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "totals" : {
            "$ref" : "#/components/schemas/Totals"
          },
          "personas" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PersonaSummary"
            }
          },
          "removedPersonas" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "PersonaSummary" : {
        "type" : "object",
        "properties" : {
          "personaId" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "added" : {
            "type" : "integer",
            "format" : "int32"
          },
          "modified" : {
            "type" : "integer",
            "format" : "int32"
          },
          "deleted" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unchanged" : {
            "type" : "integer",
            "format" : "int32"
          },
          "secretsMasked" : {
            "type" : "integer",
            "format" : "int32"
          },
          "skipped" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SkippedFile"
            }
          },
          "sourceErrors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SourceError"
            }
          }
        }
      },
      "SkippedFile" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "SourceError" : {
        "type" : "object",
        "properties" : {
          "sourceId" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "Totals" : {
        "type" : "object",
        "properties" : {
          "personas" : {
            "type" : "integer",
            "format" : "int32"
          },
          "added" : {
            "type" : "integer",
            "format" : "int32"
          },
          "modified" : {
            "type" : "integer",
            "format" : "int32"
          },
          "deleted" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unchanged" : {
            "type" : "integer",
            "format" : "int32"
          },
          "skipped" : {
            "type" : "integer",
            "format" : "int32"
          },
          "secretsMasked" : {
            "type" : "integer",
            "format" : "int32"
          },
          "sourceErrors" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "CurrentUser" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
