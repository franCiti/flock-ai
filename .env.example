# Copy to .env and fill in the secrets. Never commit .env.
# Each container only receives the variables it needs (see infra/docker-compose.yml).

# --- Connections of a Python process run on the PC (containers set their own values) ---
# Client certificate (infra/certs/out/<name>/) and the database role it maps to.
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=flock_ai
POSTGRES_USER=
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# --- LLM (agent) ---
# openrouter | fake (fake: canned answers, no API key; development only)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=
EVAL_JUDGE_MODEL=

# --- Agent behaviour ---
CONVERSATION_TTL=1d
ANSWER_TIMEOUT=2m
FIRST_TOKEN_TARGET=10s
MAX_QUESTION_CHARS=2000
MAX_REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=8
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=8
REFERRAL_MIN_SCORE=
HISTORY_TURNS=6
# Bot messages (HU11); empty = agent-service/config/messages.yaml
MESSAGES_FILE=

# --- Ingestion ---
KNOWLEDGE_ROOT=data/knowledge
INGESTION_INTERVAL=30m
MAX_FILE_MB=20

# --- Embeddings (changing the model re-indexes the whole knowledge base) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_BATCH_SIZE=32

# --- PostgreSQL superuser (administration inside the container only; services use certificates) ---
POSTGRES_ADMIN_PASSWORD=

# --- Core API initial user (only used when the users table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- External sources service accounts (stage 3, MCP servers only) ---
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
