{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:flock-ai:schema:audit-entry:v1",
  "title": "AuditEntry",
  "description": "Record of a processed request (internal). Published to agent.audit. Contains questions and answers: only the Core API may read it.",
  "type": "object",
  "required": [
    "version",
    "auditId",
    "requestId",
    "clientId",
    "conversationId",
    "personaId",
    "question",
    "answer",
    "outcome",
    "errorCode",
    "citations",
    "referralPersonaId",
    "flags",
    "llmModel",
    "promptVersion",
    "firstTokenMs",
    "totalMs",
    "createdAt"
  ],
  "properties": {
    "version": { "const": 1 },
    "auditId": { "type": "string", "format": "uuid" },
    "requestId": { "type": ["string", "null"], "format": "uuid" },
    "clientId": { "type": ["string", "null"] },
    "conversationId": { "type": ["string", "null"] },
    "personaId": { "type": ["string", "null"] },
    "question": { "type": ["string", "null"] },
    "answer": { "type": ["string", "null"] },
    "outcome": {
      "description": "The outcome of the final reply, or 'error'.",
      "type": "string",
      "enum": [
        "answered",
        "partially_answered",
        "no_information",
        "out_of_scope",
        "small_talk",
        "about_assistant",
        "error"
      ]
    },
    "errorCode": {
      "type": ["string", "null"],
      "enum": [
        "INVALID_REQUEST",
        "UNSUPPORTED_VERSION",
        "PERSONA_NOT_FOUND",
        "QUESTION_TOO_LONG",
        "RATE_LIMITED",
        "TIMEOUT",
        "LLM_UNAVAILABLE",
        "INTERNAL_ERROR",
        null
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["documentId", "title", "sourceType"],
        "properties": {
          "documentId": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": ["string", "null"], "format": "uri" },
          "path": { "type": ["string", "null"] },
          "section": { "type": ["string", "null"] },
          "sourceType": {
            "type": "string",
            "enum": ["file", "email", "email_attachment", "jira", "confluence", "sharepoint"]
          }
        }
      }
    },
    "referralPersonaId": { "type": ["string", "null"] },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["injection_suspected", "rate_limited", "question_too_long", "invalid_request"]
      }
    },
    "llmModel": { "type": ["string", "null"] },
    "promptVersion": { "type": ["string", "null"] },
    "firstTokenMs": { "type": ["integer", "null"], "minimum": 0 },
    "totalMs": { "type": ["integer", "null"], "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
